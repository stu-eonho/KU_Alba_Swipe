# Copy this file to .env.local and fill in the values.
# .env.local is gitignored - NEVER commit it.
#
# Both values come from: Supabase Dashboard > Project Settings > API

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# IMPORTANT: use the "anon / public" key, NOT the "service_role" key.
# The service_role key bypasses all Row Level Security and would expose every user's data.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME
